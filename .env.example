DATABASE_URL=postgres://careerhq:careerhq@localhost:5432/careerhq
SUBMISSIONS_LIVE_EMAIL=false
SUBMISSIONS_LIVE_COMPANY_SITE=false
SANDBOX_FORCE_SAFE=false
# DEMO_MODE=false  # sandbox-only workspace resolution, disabled credential setup, and the demo banner (spec P6 §3)
# SANDBOX_SMTP_ALLOWED_HOST=mailpit  # the only SMTP host a sandbox workspace may submit to
#   (compose service name; use "localhost" when running the app outside compose against Mailpit)
# SANDBOX_SITE_ALLOWED_HOST=demo-ats  # the only site hostname a sandbox workspace may auto-apply to
#   (compose service name; use "localhost" when running the app outside compose against demo-ats)
FOLLOW_UP_DAYS=7
# FILE_STORAGE_DIR=var/files  # relative paths resolve against the repo root
# CAREERHQ_PG_PORT=5433  # host port for the compose postgres if 5432 is taken

# Discovery / AI — all optional; every default keeps the deterministic floor working.
# OPENROUTER_API_KEY=  # unset keeps AI off: the worker's rerank pass reports skipped_no_key
# AI_FAST_MODELS=  # comma-separated OpenRouter model ids, tried in order
#   default: google/gemini-2.0-flash-exp:free,meta-llama/llama-3.3-70b-instruct:free
# AI_WRITING_MODELS=  # comma-separated OpenRouter model ids for the writing tier, tried in order
#   default: deepseek/deepseek-chat:free,meta-llama/llama-3.3-70b-instruct:free,google/gemini-2.0-flash-001
# AI_MODE=  # live (default) | record | replay — the AI record/replay layer
# AI_REPLAY_DIR=  # where recorded AI calls live; relative paths resolve against the repo root
#   default: packages/ai/fixtures/replay
# INGEST_CRON=  # cron for the worker's discovery.ingest schedule; default: 0 */6 * * *
# EMAIL_SYNC_CRON=  # cron for the worker's email.sync (IMAP poll) schedule; default: */15 * * * *

# CAREERHQ_MASTER_KEY=  # base64 32-byte key for encrypting stored email credentials; unset disables email connections
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Auto-apply (spec P5) — demo-ats is the fictional ATS e2e/demo target.
# DEMO_ATS_URL=http://localhost:3001  # compose default: http://demo-ats:3001
# AUTOAPPLY_BROWSER_TIMEOUT_MS=45000  # per-action budget for the Playwright driver
#   (one navigation, one field action, the post-submit wait) — not the whole attempt
