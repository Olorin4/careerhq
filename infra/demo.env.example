# Environment file for the hosted demo (spec P6 §3).
#
#   cp infra/demo.env.example infra/.env
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.demo.yml \
#     --profile tools run --rm migrate          # schema, once per deploy
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.demo.yml up -d --build
#
# The worker seeds the demo workspace itself on boot and again on
# DEMO_RESET_CRON, so there is no separate seed step — but the schema has to
# exist first, hence the `migrate` run above.
#
# Compose's project directory is the directory of the FIRST `-f` file, so
# `infra/.env` is the file it interpolates `${...}` from. This is not the repo
# root `.env` that `pnpm dev` uses, and the container images carry no `.env` of
# their own — Compose supplies the whole environment.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE EDITING
#
# Everything that decides whether the demo can touch the outside world is
# **pinned as a literal in `docker-compose.demo.yml`**, not interpolated from
# here. That is deliberate. `DEMO_MODE`, `SANDBOX_FORCE_SAFE`,
# `SUBMISSIONS_LIVE_EMAIL`, `SUBMISSIONS_LIVE_COMPANY_SITE`, the two
# `SANDBOX_*_ALLOWED_HOST` allow-lists, `AI_MODE`, `AI_REPLAY_DIR`,
# `AUTOAPPLY_MAX_CONCURRENT_BROWSERS`, `DEMO_RATE_LIMIT_PER_MIN` and
# `DEMO_RESET_CRON` cannot be changed from this file at all: nothing you write
# here can open a submission gate, point the demo at a real SMTP server or a
# real employer's site, or send it to a live model. Check any of it with
#
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.demo.yml config
#
# `OPENROUTER_API_KEY` is not merely unset for the demo, it is **deleted** by
# the overlay. Setting it here has no effect, and it should not be set: the
# demo runs `AI_MODE=replay` against committed fixtures precisely so anonymous
# visitors cannot spend the owner's tokens.
#
# `CAREERHQ_MASTER_KEY` is likewise pinned in the overlay, to a deliberately
# public value — see SECURITY.md, "The hosted demo's key is public on purpose".
# It must never be regenerated (the seeded mailbox is encrypted with it) and
# must never be reused anywhere real.
# ---------------------------------------------------------------------------

# What is left is scheduling and timeouts. Every one of these is optional —
# delete the file entirely and the stack still comes up with these defaults.

# How often the worker polls the configured job boards for new postings.
INGEST_CRON=0 */6 * * *

# How often the worker polls IMAP for replies. In the demo this finds nothing
# (the only mailbox is Mailpit, which cannot receive from outside), but the
# schedule is what makes the inbox page's plumbing real rather than mocked.
EMAIL_SYNC_CRON=*/15 * * * *

# Days after submitting an application before the follow-up nudge is due. The
# seed's dates are chosen against the default; changing it changes which of the
# demo's applications show up as "due" on /overview.
FOLLOW_UP_DAYS=7

# Per-action budget for the Playwright driver — one navigation, one field
# action, or the post-submit wait. Not the budget for a whole attempt. The
# bundled demo-ats is local and fast; this headroom is for a loaded box, not a
# slow site.
AUTOAPPLY_BROWSER_TIMEOUT_MS=45000

# The fictional ATS, by compose service name. The only auto-apply destination
# the demo has, and `SANDBOX_SITE_ALLOWED_HOST=demo-ats` (pinned in the
# overlay) is what actually enforces that — this variable only says where to
# look, it grants nothing.
DEMO_ATS_URL=http://demo-ats:3001

# Deliberately absent, and worth saying so:
#
#   CAREERHQ_PG_PORT — the demo publishes no Postgres port at all. Use
#     `docker compose ... exec postgres psql -U careerhq` instead.
#   AI_FAST_MODELS / AI_WRITING_MODELS — model lists are meaningless with no
#     API key and AI_MODE=replay; the fixtures are keyed by prompt, not model.
