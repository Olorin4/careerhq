# The web service drives a real browser too, so it needs the same base the
# worker needs — NOT node:22-alpine.
#
# `apps/web/src/lib/site-driver.ts` (`makeSiteCapture`/`makeSiteSubmit`, wired
# into the "use server" auto-apply actions) calls `openSession()` →
# `chromium.launch()` in-process: the interactive prepare/preview/confirm flow
# does not hand the page off to `apps/worker`. On alpine that launch cannot
# succeed — no libnss3/libatk/libgbm/fonts, and Playwright publishes no musl
# browser builds — so under compose every prepare failed to read the page and
# every confirm reported a browser it never started.
#
# Everything Dockerfile.worker's header says about the tag applies here
# verbatim: it MUST stay in lockstep with the `playwright` version pinned in
# apps/web/package.json AND apps/worker/package.json, because the npm package
# only launches the browser build it shipped with and the image carries exactly
# that build under PLAYWRIGHT_BROWSERS_PATH=/ms-playwright. apps/web reaches the
# driver through `@careerhq/worker/autoapply`, but it is apps/web's OWN
# dependency that makes `require("playwright")` resolve inside the externalised
# Next bundle — that is the pin that matters for THIS image.
# Bump all four together — worker image, web image, and both npm pins.
FROM mcr.microsoft.com/playwright:v1.62.1-noble AS build
RUN corepack enable
WORKDIR /app
# The lockfile has an importer entry for every workspace package, so copying
# only some of them fails `--frozen-lockfile` (ERR_PNPM_OUTDATED_LOCKFILE).
# Copy the whole workspace; .dockerignore keeps node_modules, build output and
# the file volume out of the context.
COPY . .
# `--prod=false` is pnpm's default; stated for symmetry with Dockerfile.worker,
# whose closing note explains why the dev half is not dropped again afterwards.
RUN pnpm install --frozen-lockfile --prod=false
RUN pnpm --filter @careerhq/web... build
# `.next/cache` is webpack's incremental build cache — `next start` never opens
# it. Deleted HERE, in the stage that gets discarded, so the runtime image never
# carries a layer it was removed from (a `rm` after the COPY would leave the
# bytes in the parent layer and shrink nothing).
RUN rm -rf apps/web/.next/cache

# See Dockerfile.worker for what the runtime stage's single COPY leaves behind.
FROM mcr.microsoft.com/playwright:v1.62.1-noble AS runtime
RUN corepack enable
WORKDIR /app
COPY --from=build /app /app
# Corepack's cached pnpm tarball. It matters more here than in the worker: this
# image's CMD *is* pnpm, so without it every container start first downloads
# pnpm from registry.npmjs.org before the app can boot. See Dockerfile.worker.
COPY --from=build /root/.cache/node /root/.cache/node
CMD ["pnpm", "--filter", "@careerhq/web", "start"]
